# Base
ENVIRONMENT='production'
PROJECT_NAME='kiki-core-stack'

# Server
SERVER_WORKERS=4

## Proxies trusted by getClientIp to forward X-Forwarded-For (comma-separated IPs, CIDRs, or loopback/linklocal/uniquelocal).
## Default: loopback,linklocal,uniquelocal. This covers nginx on the same host, in the same Docker network, or on a private LAN.
## Only set this when a proxy reaches the app from a public IP, such as nginx on another public host or a CDN. Setting it
## replaces the default, so keep the named subnets: 'loopback,linklocal,uniquelocal,203.0.113.0/24'.
## Set it empty to ignore X-Forwarded-For. nginx must send: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# SERVER_TRUSTED_PROXIES='loopback,linklocal,uniquelocal'

# Session
SESSION_CIPHER_KEY='' # must be 32 bytes (256 bits for AES-256) when parsed as ASCII
