# Base
ENVIRONMENT='development'
PROJECT_NAME='kiki-core-stack'

# Cookie session

## Base64-encoded 32-byte keys, comma-separated for rotation (the first encrypts). Generate: openssl rand -base64 32
COOKIE_SESSION_KEYS=''

# Development

## Log a warning when a JSON response does not match its documented schema.
VALIDATE_RESPONSES=false

# Public
MONGODB_RS_HOST='127.0.0.1'
MONGODB_URI="mongodb://${MONGODB_RS_HOST}:27017/${PROJECT_NAME}-${ENVIRONMENT}?directConnection=true&replicaSet=rs0"
NPM_CONFIG_REGISTRY='https://registry.npmjs.org'
REDIS_URL='redis://127.0.0.1:6379'

# Server
SERVER_HOST='127.0.0.1'
SERVER_PORT=8080
