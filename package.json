{
  "type": "module",
  "private": true,
  "scripts": {
    "base:dev": "NODE_ENV=development bun --env-file=./.env.development.local",
    "base:prod": "NODE_ENV=production bun --env-file=./.env.production.local",
    "bootstrap:dev": "bun run base:dev -- run ./src/core/bootstrap/index.ts",
    "bootstrap:prod": "bun run base:prod -- run ./src/core/bootstrap/index.ts",
    "build": "bun run base:prod -- run ./src/core/build.ts",
    "dev": "NODE_ENV=development nodemon",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kcs-project/pack": "git+https://github.com/kiki-core-stack/pack#7962e588b143ede96e738befd405829504120f9c",
    "@kikiutils/mongoose": "^9.0.3",
    "@kikiutils/shared": "^20.1.2",
    "es-toolkit": "^1.53.2",
    "hono": "^4.13.18",
    "hono-openapi": "^1.5.0",
    "mongoose": "^9.12.1",
    "nanoid": "^6.0.2",
    "node-ciphers": "^6.1.5",
    "on-change": "^6.0.2",
    "sharp": "^0.35.5",
    "ts-extras": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@hono/swagger-ui": "^0.6.2",
    "@kikiutils/eslint-config": "^11.0.1",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@scalar/hono-api-reference": "^0.12.20",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "knip": "^6.45.1",
    "mlly": "^1.8.2",
    "nodemon": "^3.1.14",
    "pretty-bytes": "^7.2.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unimport": "^7.0.2"
  },
  "overrides": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
