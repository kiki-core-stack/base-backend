{
  "type": "module",
  "private": true,
  "scripts": {
    "base:dev": "NODE_ENV=development bun --env-file=./.env.development.local",
    "base:prod": "NODE_ENV=production bun --env-file=./.env.production.local",
    "bootstrap:dev": "bun run base:dev -- run ./src/core/bootstrap/index.ts",
    "bootstrap:prod": "bun run base:prod -- run ./src/core/bootstrap/index.ts",
    "build": "bun run base:prod -- run ./src/core/build.ts",
    "dev": "NODE_ENV=development nodemon",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@kikiutils/shared": "^19.0.0",
    "es-toolkit": "^1.53.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/swagger-ui": "^0.6.1",
    "@kikiutils/eslint-config": "^9.3.2",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@scalar/hono-api-reference": "^0.12.14",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "knip": "^6.43.0",
    "mlly": "^1.8.2",
    "nodemon": "^3.1.14",
    "openapi3-ts": "^4.6.2",
    "pretty-bytes": "^7.2.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unimport": "^7.0.2"
  },
  "overrides": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  }
}
