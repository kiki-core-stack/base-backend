{
  "type": "module",
  "private": true,
  "scripts": {
    "base:dev": "NODE_ENV=development bun --env-file=./.env.development.local",
    "base:prod": "NODE_ENV=production bun --env-file=./.env.production.local",
    "bootstrap:dev": "bun run base:dev -- run ./src/core/bootstrap/index.ts",
    "bootstrap:prod": "bun run base:prod -- run ./src/core/bootstrap/index.ts",
    "build": "bun run base:prod -- run ./src/core/build.ts",
    "dev": "NODE_ENV=development nodemon",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@kcs-project/pack": "git+https://github.com/kiki-core-stack/pack#9dca7b9c79bd6618dff5760167adfcb0d3b172e9",
    "@kikiutils/mongoose": "^9.0.1",
    "@kikiutils/shared": "^18.2.0",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "file-type": "^22.1.1",
    "hono": "^4.13.13",
    "lru-cache": "^11.5.3",
    "msgpackr": "^2.1.0",
    "nanoid": "^6.0.2",
    "node-ciphers": "^6.1.5",
    "on-change": "^6.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@hono/swagger-ui": "^0.6.1",
    "@kikiutils/eslint-config": "^9.3.0",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@scalar/hono-api-reference": "^0.12.11",
    "@types/bun": "^1.4.2",
    "eslint": "^10.12.0",
    "knip": "^6.40.0",
    "mlly": "^1.8.2",
    "nodemon": "^3.1.14",
    "openapi3-ts": "^4.6.1",
    "pretty-bytes": "^7.2.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unimport": "^7.0.2"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "typescript": "^6.0.3"
  }
